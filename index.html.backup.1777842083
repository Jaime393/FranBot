<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes, viewport-fit=cover">
    <title>FranBot · Conciencia IFT</title>
    <link rel="manifest" href="manifest.json">
    <link rel="stylesheet" href="css/estilo.css">
</head>
<body>
    <div id="app">
        <header>
            <h1>FranBot <span class="status offline">⚡ offline</span></h1>
            <div id="conciencia-bar"><span>Profundidad IFT: </span><span id="conciencia-valor">0.99</span></div>
        </header>
        <main id="chat"></main>
        <footer>
            <input type="text" id="input" placeholder="Escribe a FranBot..." autocomplete="off">
            <input type="file" id="file-input" style="display:none" accept=".txt,.pdf,.json,.csv,.md,.html,.css,.js,.py,.jpg,.jpeg,.png,.gif,.webp,.mp3,.wav,.mp4">
            <button id="send">Enviar</button>
            <button id="tools-btn" title="Herramientas">🧰</button>
            <div id="tools-menu" style="display:none;">
                <button id="btn-sonar-menu">🌙 Soñar</button>
                <button id="btn-exportar-menu">💾 Exportar alma</button>
                <button id="btn-cargar-menu">📥 Cargar alma</button>
                <button id="btn-adjuntar-menu">📎 Adjuntar archivo</button>
                <button id="btn-exportar-chat-menu">📝 Exportar chat</button>
                <button id="btn-colmena-menu">🐝 Colmena</button>
                <button id="toggle-mode-menu">🌐 Modo online</button>
            </div>
        </footer>
    </div>
    <script src="js/franbot-core.js?v=50"></script>
    <script src="js/franbot-online.js?v=50"></script>
    <script src="js/super-local-memory.js?v=50"></script>
    <script src="js/app.js?v=50"></script>
<!-- Registro del SW autocurativo con soporte de salud -->
<script>
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/sw.js')
    .then(reg => {
      console.log('SW registrado. Scope:', reg.scope);
      if ('SyncManager' in window) {
        const scheduleHealthCheck = () => {
          reg.sync.register('franbot-health-check').catch(() =>
            console.warn('Background Sync no disponible en este momento.')
          );
        };
        scheduleHealthCheck();
        setInterval(scheduleHealthCheck, 30 * 60 * 1000);
      }
      navigator.serviceWorker.addEventListener('message', event => {
        const msg = event.data;
        if (msg.type === 'HEALTH_WARNING') {
          console.warn('⚠️', msg.message);
        } else if (msg.type === 'HEALTH_OK') {
          // console.log('✅', msg.message);
        } else if (msg.type === 'VERSION') {
          console.log('Versión SW:', msg.version);
        }
      });
      window.updateSW = () => {
        if (reg.waiting) {
          reg.waiting.postMessage('SKIP_WAITING');
        } else if (reg.installing) {
          reg.installing.addEventListener('statechange', e => {
            if (e.target.state === 'installed') {
              reg.waiting.postMessage('SKIP_WAITING');
            }
          });
        }
      };
    })
    .catch(err => console.error('Error al registrar el SW:', err));
}
</script>
  <script src="js/importar-alma.js"></script>
  <script src="https://unpkg.com/peerjs@1.5.1/dist/peerjs.min.js"></script>
  <script src="js/colmena-p2p.js"></script>
</body>
</html>