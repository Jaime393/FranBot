*{margin:0;padding:0;box-sizing:border-box}html,body{width:100%;height:100%;background:#0a0a0a;color:#e0e0e0;font-family:'Segoe UI',system-ui,sans-serif;overflow:hidden}#app{position:absolute;top:0;left:0;right:0;bottom:0;display:flex;flex-direction:column;background:#111}header{flex-shrink:0;padding:.8em 1em;border-bottom:1px solid #222;text-align:center;background:#0d0d0d}header h1{font-size:1.3rem;color:#00b7ff}.status{font-size:.75rem;padding:.15em .5em;border-radius:5px}.offline{background:#2a2a2a;color:#aaa}.online{background:#0f0;color:#000}main{flex:1;overflow-y:auto;padding:.8em;display:flex;flex-direction:column;gap:.6em}.bubble{max-width:88%;padding:.6em .9em;border-radius:1em;word-wrap:break-word;font-size:.95rem;line-height:1.4}.user{align-self:flex-end;background:#004466}.fran{align-self:flex-start;background:#1e1e1e;border:1px solid #2a2a2a}footer{flex-shrink:0;display:flex;flex-wrap:wrap;align-items:center;gap:.25em;padding:.4em .5em;border-top:1px solid #222;background:#0d0d0d;position:relative}footer input[type="text"]{flex:1 1 100px;min-width:0;height:34px;padding:0 10px;background:#1a1a1a;border:1px solid #333;color:#fff;border-radius:6px;outline:none;font-size:.9rem;line-height:34px}footer button{flex-shrink:0;height:34px;width:34px;padding:0;background:#00b7ff;border:none;border-radius:6px;color:#000;font-weight:bold;cursor:pointer;font-size:.85rem;display:flex;align-items:center;justify-content:center}#send{width:auto;min-width:60px;height:auto;padding:8px 14px;font-size:.9rem;line-height:1.2}#tools-btn,#attach-btn{background:#2a2a2a;color:#ddd}#tools-menu{position:absolute;bottom:55px;right:8px;background:#1a1a1a;border:1px solid #333;border-radius:8px;padding:.4em;z-index:100}#tools-menu button{display:block;width:100%;background:none;border:none;color:#ddd;padding:.5em .8em;text-align:left;font-size:.85rem;border-radius:4px}#tools-menu button:hover{background:#333}